<div class="simple-calendar">
  <div class="calendar-heading">
    <%# Month arrows flank the title ("‹ December 2026 ›"); Today sits on the right %>
    <nav class="calendar-heading__month" aria-label="Change month">
      <%= link_to '‹', calendar.url_for_previous_view, class: 'calendar-heading__arrow',
                  aria: { label: t('simple_calendar.previous', default: 'Previous month') } %>
      <time datetime="<%= start_date.strftime('%Y-%m') %>" class="calendar-title"><%= t('date.month_names')[start_date.month] %> <%= start_date.year %></time>
      <%= link_to '›', calendar.url_for_next_view, class: 'calendar-heading__arrow',
                  aria: { label: t('simple_calendar.next', default: 'Next month') } %>
    </nav>

    <%= link_to t('simple_calendar.today', default: 'Today'), calendar.url_for_today_view, class: 'calendar-heading__today' %>
  </div>

  <table>
    <thead>
      <tr>
        <% date_range.slice(0, 7).each do |day| %>
          <th><%= t('date.abbr_day_names')[day.wday] %></th>
        <% end %>
      </tr>
    </thead>

    <tbody>
      <% date_range.each_slice(7) do |week| %>
        <tr>
          <% week.each do |day| %>
            <%= content_tag :td, class: calendar.td_classes_for(day) do %>
              <% instance_exec(day, calendar.sorted_events_for(day), &passed_block) %>
            <% end %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
