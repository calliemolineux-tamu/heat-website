<main class="container-full" data-controller="modal day-events">
  <header class="header events-header">
    <h1>EVENTS</h1>
    <% create_link = create_link_for(@role) %>
    <%= link_to create_link[:name], create_link[:path], class: create_link[:class],
                 data: { turbo_frame: dom_id(Event.new), action: 'click->modal#open' } if create_link.present? %>
  </header>

  <div class="events" data-controller="event-tile-height">
    <div class="calendar-container" data-event-tile-height-target="calendar">
      <%= render 'events/month_calendar_panel', events: @events %>
    </div>

    <div class="event__container" id="event_container" data-controller="committee-filter" data-event-tile-height-target="tile">
      <h2 class="event__container-title">Upcoming Events</h2>

      <div class="event__committee-filter">
        <button type="button" class="event__committee-filter-tab is-active" data-committee="all"
                data-action="click->committee-filter#filter" data-committee-filter-target="tab">All</button>
        <% Event.committees.each_key do |committee| %>
          <button type="button" class="event__committee-filter-tab" data-committee="<%= committee %>"
                  data-action="click->committee-filter#filter" data-committee-filter-target="tab"><%= committee.humanize %></button>
        <% end %>
      </div>

      <div id="event_list">
        <%= render 'events/event_list', events: @upcoming_events %>
      </div>
    </div>
  </div>

  <div id="day-events-modal" class="modal" data-day-events-target="dialog"
       data-action="click->day-events#closeBackground">
    <div class="modal-content">
      <div class="modal-header">
        <h3 data-day-events-target="title"></h3>
        <button type="button" class="modal-close" data-action="click->day-events#close" aria-label="Close">&times;</button>
      </div>
      <div data-day-events-target="body"></div>
    </div>
  </div>

  <% if @role == 'admin' %>
    <%= render 'events/event_modal' %>
  <% end %>
</main>
