<%# The list of event cards for the current month, factored out so it can be
    fully re-rendered via Turbo Stream after an inline create. %>
<% if events.any? %>
  <% events.each do |event| %>
    <%= render 'events/event_card', event: event %>
  <% end %>
<% else %>
  <p class="event__empty">No events scheduled this month.</p>
<% end %>
